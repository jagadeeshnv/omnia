#!/bin/bash
CONTROLLER_IP="{{ hostvars['oim']['controller_ip'] }}"
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=10 -o BatchMode=yes"

echo "Waiting for controller ($CONTROLLER_IP) to become reachable..."

# Fast pre-filter: wait for basic network reachability before attempting SSH
while ! ping -c1 -W1 "$CONTROLLER_IP" &>/dev/null; do
    echo "Controller not reachable. Retrying in 5 seconds..."
    sleep 5
done
echo "Controller is reachable."

echo "Checking if slurmctld service is active on controller..."
while true; do
    if ssh $SSH_OPTS "$CONTROLLER_IP" "systemctl is-active --quiet slurmctld"; then
        echo "slurmctld service is active on controller. Proceeding."
        break
    else
        echo "slurmctld not yet active. Retrying in 5 seconds..."
        sleep 5
    fi
done
